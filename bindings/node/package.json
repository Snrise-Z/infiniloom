{
  "name": "infiniloom-node",
  "version": "0.6.1",
  "description": "Node.js bindings for Infiniloom - AST-aware code context engine for RAG and vector databases. Tree-sitter parsing, PageRank ranking, BLAKE3 content-addressable chunks, 27+ tokenizers.",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "infiniloom",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "armv7-unknown-linux-gnueabihf",
        "aarch64-apple-darwin",
        "aarch64-linux-android",
        "x86_64-unknown-freebsd",
        "aarch64-unknown-linux-musl",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "author": "Topos Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Topos-Labs/infiniloom.git",
    "directory": "bindings/node"
  },
  "keywords": [
    "infiniloom",
    "llm",
    "rag",
    "retrieval-augmented-generation",
    "vector-database",
    "pinecone",
    "weaviate",
    "qdrant",
    "embeddings",
    "code-context",
    "code-analysis",
    "ast",
    "tree-sitter",
    "pagerank",
    "content-addressable",
    "blake3",
    "claude",
    "gpt4o",
    "gpt5",
    "gemini",
    "llama",
    "napi-rs",
    "rust",
    "ai-tools",
    "tiktoken",
    "code-chunking"
  ],
  "engines": {
    "node": ">= 16"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "bugs": {
    "url": "https://github.com/Topos-Labs/infiniloom/issues"
  },
  "homepage": "https://toposlabs.ai/infiniloom/"
}