{
  "name": "infiniloom-node",
  "version": "0.7.0",
  "description": "Node.js bindings for Infiniloom - AST-aware code context engine for RAG and vector databases. Tree-sitter parsing, PageRank ranking, BLAKE3 content-addressable chunks, 27+ tokenizers.",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "infiniloom",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin"
      ]
    }
  },
  "author": "Topos Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Topos-Labs/infiniloom.git",
    "directory": "bindings/node"
  },
  "keywords": [
    "infiniloom",
    "llm",
    "rag",
    "retrieval-augmented-generation",
    "vector-database",
    "pinecone",
    "weaviate",
    "qdrant",
    "embeddings",
    "code-context",
    "code-analysis",
    "ast",
    "tree-sitter",
    "pagerank",
    "content-addressable",
    "blake3",
    "claude",
    "gpt4o",
    "gpt5",
    "gemini",
    "llama",
    "napi-rs",
    "rust",
    "ai-tools",
    "tiktoken",
    "code-chunking"
  ],
  "engines": {
    "node": ">= 16"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:types": "tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir .",
    "prepublishOnly": "napi prepublish -t npm && npm run build:types",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "version": "napi version"
  },
  "dependencies": {
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "types.ts",
    "types.d.ts",
    "schemas.ts",
    "schemas.d.ts",
    "schemas.js",
    "tsconfig.json",
    "*.node"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.js"
    },
    "./types": {
      "types": "./types.d.ts",
      "require": "./types.js",
      "import": "./types.js"
    },
    "./schemas": {
      "types": "./schemas.d.ts",
      "require": "./schemas.js",
      "import": "./schemas.js"
    }
  },
  "typesVersions": {
    "*": {
      "types": ["./types.d.ts"],
      "schemas": ["./schemas.d.ts"]
    }
  },
  "bugs": {
    "url": "https://github.com/Topos-Labs/infiniloom/issues"
  },
  "homepage": "https://toposlabs.ai/infiniloom/"
}